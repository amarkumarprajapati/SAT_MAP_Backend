# Application
APP_ENV=production
HOST=0.0.0.0
PORT=8000
BASE_URL=https://api.example.com
API_PREFIX=/api
CORS_ORIGINS=http://localhost:3000/

# PostgreSQL (change the password before deployment)
POSTGRES_DB=sat_map
POSTGRES_USER=sat_map
POSTGRES_PASSWORD=sat_map@2026
DATABASE_REQUIRED=true
DATABASE_POOL_SIZE=5
DATABASE_COMMAND_TIMEOUT=10

# Optional live data credentials
AIS_API_KEY=
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# OSINT NestJS service URL; Docker Compose overrides this with its service name.
OSINT_SERVICE_URL=http://127.0.0.1:5000
